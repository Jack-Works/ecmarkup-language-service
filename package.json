{
    "name": "meta",
    "private": true,
    "type": "module",
    "workspaces": {
        "packages": [
            "language-server",
            "extension-vscode",
            "ecmarkup"
        ]
    },
    "installConfig": {
        "hoistingLimits": "dependencies"
    },
    "description": "Language server and editor plugins for ecmarkup",
    "author": "Jack Works",
    "license": "MIT",
    "scripts": {
        "release": "node ./release.mjs",
        "watch": "tsc -b . -w",
        "build": "tsc -b ."
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.2",
        "@changesets/cli": "^3.0.3",
        "typescript": "^7.0.2",
        "vite": "^7.0.0",
        "vitest": "^5.0.5"
    },
    "packageManager": "yarn@4.18.1"
}
