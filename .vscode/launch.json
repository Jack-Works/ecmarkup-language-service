{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node-terminal",
            "request": "launch",
            "name": "Launch Client",
            "command": "code --new-window --inspect-extensions=9229 --extensionDevelopmentPath=\"${workspaceFolder}/extension-vscode\" \"${workspaceFolder}\"",
            "preLaunchTask": {
                "type": "npm",
                "script": "watch"
            }
        },
        {
            "type": "node",
            "request": "attach",
            "name": "Attach to Extension Host",
            "port": 9229,
            "restart": true,
            "timeout": 0,
            "outFiles": ["${workspaceFolder}/extension-vscode/lib/**/*.js"],
            "sourceMaps": true
        },
        {
            "type": "node",
            "request": "attach",
            "name": "Attach to Server",
            "port": 29381,
            "restart": true,
            "outFiles": ["${workspaceFolder}/language-server/lib/**/*.js"],
            "sourceMaps": true
        }
    ]
}
